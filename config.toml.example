listen_addr = "0.0.0.0:8888"
base_url    = "https://integrate.api.nvidia.com"

# Allow pointing base_url at a loopback/localhost address (e.g. a local
# NVIDIA-compatible mock during testing). Off by default.
allow_local_base_url = false

# Request timeout in seconds. Set to 0 to disable (recommended for streaming).
# Streaming requests bypass this timeout regardless.
request_timeout_seconds = 60

# Inject `stream_options.include_usage: true` into streaming chat requests so
# NVIDIA returns token usage at stream end (default true). Disable to leave
# streaming requests untouched. Env override: NVIDIA_INJECT_STREAM_USAGE.
inject_stream_usage = true

# Synthesize a placeholder `choices` entry when upstream returns a 2xx
# non-SSE body whose `choices` array is empty (`choices: []`). Defaults to
# true; disable via NVIDIA_SYNTHESIZE_EMPTY_CHOICES=false.
synthesize_empty_choices = true

# On NVIDIA's "empty-shell" soft failure — a 200 whose body is
# `{"choices":[],"id":"","usage":null,...}` (no real inference ran; common on
# `/compact` with max_tokens larger than the model's remaining context budget) —
# retry once with max_tokens clamped to `empty_shell_retry_max_tokens` before
# giving up and surfacing a 502. Without this, Claude Code's `/compact` prints
# the misleading "summarization produced empty response". Defaults to true;
# disable via NVIDIA_RETRY_ON_EMPTY_SHELL=false.
retry_on_empty_shell = true

# max_tokens used for the post-shell retry. The first upstream call may itself
# be pre-clamped by `empty_shell_pre_clamp_max_tokens` (below) so the budget
# fits without burning a round-trip into a guaranteed shell. 8192 is
# conservative across GLM-family models on build.integrate.
# Env override: NVIDIA_EMPTY_SHELL_RETRY_MAX_TOKENS.
empty_shell_retry_max_tokens = 8192

# Per-model max_tokens ceiling clamped on the *first* upstream call (streaming
# included). NVIDIA's GLM-class models return a 200 "empty-shell" body when
# `prompt + max_tokens` exceeds the remaining context budget; clamping at the
# entrance makes the budget fit so inference actually runs. Optional, empty =
# no pre-clamp. Default includes z-ai/glm-5.2 → 8192.
# Override via NVIDIA_EMPTY_SHELL_PRE_CLAMP_MAX_TOKENS (JSON map).
# empty_shell_pre_clamp_max_tokens = { "z-ai/glm-5.2" = 8192 }

# Prompt-token estimate threshold above which an empty-shell soft failure is
# NOT retried with a clamped max_tokens; the proxy surfaces 502 immediately.
# failure.log showed clamp-retry on 107k+ prompts recovered 0%, so retrying
# only wastes a round-trip and a key slot. 0 disables the bypass (always
# retry). Default 90000.
# Override via NVIDIA_EMPTY_SHELL_NO_RETRY_PROMPT_TOKENS.
# empty_shell_no_retry_prompt_tokens = 90000

# Hard ceiling on estimated prompt tokens: a request at/above this is rejected
# with HTTP 413 before any upstream call, asking the client to compress its own
# context. Set EQUAL to the soft `empty_shell_no_retry_prompt_tokens` (both
# 90000) — no grey band between them. Two rounds of measurement showed any
# "one shot" band just produced guaranteed shells + a misleading 502 the client
# retried for minutes: at ~92k estimated (chars/4, which understates real
# tokens), `prompt + max_tokens` already overflows glm-5.2's ~128k window. So
# est >= 90000 → 413 immediately, zero upstream round-trip. Does NOT rewrite the
# client's messages. 0 disables. Default 90000.
# Override via NVIDIA_REQUEST_MAX_PROMPT_TOKENS.
# request_max_prompt_tokens = 90000

# ── Multimodal prompt-token estimation ───────────────────────────────────────
# The proxy forwards OpenAI-style multimodal content arrays (image_url /
# input_audio blocks) to NVIDIA NIM untouched. The prompt-token estimate used
# by the 413 hard ceiling and the 90k empty-shell soft limit must NOT be fooled
# by them: an inline base64 `data:…;base64,…` image is tens of thousands of
# chars (chars/4 would balloon the estimate and 413 a legal request), and a
# URL-only image is a few dozen chars (would undercount and slip past).
# So each non-text content block is replaced by a coarse fixed/tokenized cost:
#   {type:"text"}        → chars/4 as before
#   {type:"image_url"}   → est_image_token_cost (flat, URL or base64 alike)
#   {type:"input_audio"} → est_audio_token_per_kb × (base64 chars/1024),
#                          capped at est_audio_token_cap
#   anything else        → chars/4 capped at est_unknown_part_token_cap,
#                          so a stray base64 blob can't blow the estimate up.
# Defaults tuned conservatively; override per-environment as needed.
# Env overrides: NVIDIA_EST_IMAGE_TOKEN_COST,
#                 NVIDIA_EST_AUDIO_TOKEN_PER_KB,
#                 NVIDIA_EST_AUDIO_TOKEN_CAP,
#                 NVIDIA_EST_UNKNOWN_PART_TOKEN_CAP.
# est_image_token_cost      = 1500
# est_audio_token_per_kb    = 16
# est_audio_token_cap       = 10000
# est_unknown_part_token_cap = 2000

# Retry 500 Internal Server Error (transient GLM "Failed to generate
# completions") against another key with backoff. Default true.
# Env override: NVIDIA_RETRY_ON_500.
# retry_on_500 = true

# API keys – can also be set via NVIDIA_KEYS env var (comma-separated)
keys = [
    "nvapi-xxxxxxxxxxxxxxxx1",
    "nvapi-xxxxxxxxxxxxxxxx2",
    "nvapi-xxxxxxxxxxxxxxxx3",
]

[rate_limiter]
qps_per_key = 0.65
burst       = 8
# Maximum milliseconds to wait for a token before switching to another key.
# 0 disables switching. Default: 200.
token_wait_ms = 200

[cooldown]
base_seconds = 60
max_seconds  = 600

[health_check]
interval_seconds = 30
timeout_seconds  = 5
max_consecutive_failures = 3

[observability]
enable_metrics = true
metrics_path   = "/metrics"
log_level      = "info"

[retry]
# Upstream (NVIDIA) auth retry policy.
# Only a 401 *without* `Retry-After` triggers a retry against another healthy
# key with exponential backoff. 429/403 (and 401 with `Retry-After`) are NOT
# retried: they are deterministic upstream decisions and retrying on another
# key would only burn the whole pool. A `Retry-After` value cools the
# offending key; otherwise the response is surfaced to the client unchanged.
max_retries           = 3      # retry attempts per client request (excluding initial)
backoff_base_ms       = 200    # first retry sleeps ~backoff_base_ms
backoff_max_ms        = 2000   # single backoff cap
auth_fail_threshold   = 3      # consecutive auth-failures to disable a key
# Max times a single request may switch to another key when the current
# key's token bucket is starved. Decoupled from `max_retries` (the upstream
# 401 retry budget). Defaults to `max_retries`.
max_key_switches       = 3

# Front-door authentication for the proxy itself. The NVIDIA quota behind
# the pool is exposed to anyone who can reach `listen_addr`; enabling this
# requires clients to present `Authorization: Bearer <bearer_token>` on
# `/v1/*` requests. Disabled by default to preserve the "any api_key works"
# behaviour existing clients rely on. `/health` is always exempt.
[auth]
enabled       = false
bearer_token  = ""      # client bearer token; also NVIDIA_AUTH_BEARER_TOKEN
admin_token   = ""      # protects /admin/* ; also NVIDIA_AUTH_ADMIN_TOKEN
                        # when empty the admin API is completely disabled (404)

[model_aliases]
#   "z-ai/glm-5.2"        = "z-ai/glm-5.2"
#   "gpt-4o"              = "meta/llama-3.1-405b-instruct"
#   "gpt-4o-mini"         = "meta/llama-3.1-70b-instruct"
